rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Students collection for Ponpes Salamatul Insan
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.isPresent is bool;
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidId(notificationId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150;
      allow delete: if false;
    }
  }
}
